<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %><c:set var="pageTitle" value="Car details | Roadwise"/><%@ include file="../common/header.jsp" %>
<a class="small text-decoration-none" href="${pageContext.request.contextPath}/cars"><i class="bi bi-arrow-left"></i> Back to cars</a>
<div class="row g-4 mt-1"><div class="col-lg-7"><c:choose><c:when test="${not empty car.imageUrl}"><c:choose><c:when test="${fn:startsWith(car.imageUrl, '/assets/images/')}"><img src="${pageContext.request.contextPath}<c:out value='${car.imageUrl}'/>" class="detail-image rounded-4" alt="Car"></c:when><c:otherwise><img src="<c:out value='${car.imageUrl}'/>" class="detail-image rounded-4" alt="Car"></c:otherwise></c:choose></c:when><c:otherwise><img src="${pageContext.request.contextPath}/assets/images/car-placeholder.svg" class="detail-image rounded-4" alt="Car"></c:otherwise></c:choose></div>
<div class="col-lg-5"><span class="badge text-bg-light mb-2"><c:out value="${car.category}"/></span><h1><c:out value="${car.brand}"/> <c:out value="${car.model}"/></h1><p class="text-secondary">A comfortable, dependable choice for your next trip.</p><div class="spec-grid"><div><small>Fuel</small><strong><c:out value="${car.fuelType}"/></strong></div><div><small>Transmission</small><strong><c:out value="${car.transmission}"/></strong></div><div><small>Seats</small><strong><c:out value="${car.seatingCapacity}"/></strong></div><div><small>Category</small><strong><c:out value="${car.category}"/></strong></div></div>
<div class="price-panel mt-4"><strong class="fs-3" data-daily-rate="<c:out value='${car.dailyRate}'/>">$<c:out value="${car.dailyRate}"/></strong><span class="text-secondary"> / day</span><c:choose><c:when test="${sessionScope.authenticatedUser.role eq 'CUSTOMER'}"><form class="mt-3" method="post" action="${pageContext.request.contextPath}/customer/bookings/create" id="bookingForm"><input type="hidden" name="_csrf" value="<c:out value='${requestScope.csrfToken}'/>"><input type="hidden" name="carId" value="${car.id}"><div class="mb-2"><label class="form-label" for="pickupDate">Pickup date</label><input required class="form-control" type="date" id="pickupDate" name="pickupDate" data-date-min="today"></div><div class="mb-2"><label class="form-label" for="returnDate">Return date</label><input required class="form-control" type="date" id="returnDate" name="returnDate"></div><p class="small text-secondary mb-2" id="estimate">Select your dates for an estimate. The server recalculates the final booking price.</p><button class="btn btn-primary w-100">Confirm booking</button></form></c:when><c:when test="${empty sessionScope.authenticatedUser}"><a class="btn btn-primary mt-3" href="${pageContext.request.contextPath}/login">Sign in to book</a></c:when><c:otherwise><p class="small text-secondary mt-3 mb-0">Administrator accounts manage the fleet.</p></c:otherwise></c:choose></div></div></div>
<%@ include file="../common/footer.jsp" %>
