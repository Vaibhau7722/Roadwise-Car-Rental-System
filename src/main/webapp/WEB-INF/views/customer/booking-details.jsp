<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Booking details | Roadwise"/><%@ include file="../common/header.jsp" %><div class="page-heading"><span class="eyebrow">BOOKING DETAILS</span><h1><c:out value="${booking.reference}"/></h1><p><span class="status status-${booking.status}"><c:out value="${booking.status}"/></span></p></div><div class="row g-4"><div class="col-lg-8"><div class="content-card"><h2 class="h5"><c:out value="${booking.brand}"/> <c:out value="${booking.model}"/></h2><p class="text-secondary mb-4">Registration <c:out value="${booking.registrationNumber}"/></p><div class="row"><div class="col-sm-6 mb-3"><small class="text-secondary">Pickup</small><div><c:out value="${booking.pickupDate}"/></div></div><div class="col-sm-6 mb-3"><small class="text-secondary">Return</small><div><c:out value="${booking.returnDate}"/></div></div><div class="col-sm-6 mb-3"><small class="text-secondary">Rental duration</small><div><c:out value="${booking.rentalDays}"/> days</div></div><div class="col-sm-6 mb-3"><small class="text-secondary">Daily rate agreed</small><div>$<c:out value="${booking.dailyRate}"/></div></div></div><hr><div class="d-flex justify-content-between"><span>Base rental charge</span><strong>$<c:out value="${booking.baseAmount}"/></strong></div><c:if test="${booking.lateDays gt 0}"><div class="d-flex justify-content-between mt-2"><span>Late fee (<c:out value="${booking.lateDays}"/> days)</span><strong>$<c:out value="${booking.lateFee}"/></strong></div></c:if><div class="d-flex justify-content-between mt-2 fs-5"><span>Current final charge</span><strong>$<c:out value="${booking.finalCharge}"/></strong></div></div></div><div class="col-lg-4"><div class="content-card"><h2 class="h5">Manage booking</h2><c:if test="${booking.status eq 'CONFIRMED'}"><form method="post" action="${pageContext.request.contextPath}/customer/bookings/cancel" onsubmit="return confirm('Cancel this booking?')"><input type="hidden" name="_csrf" value="<c:out value='${requestScope.csrfToken}'/>"><input type="hidden" name="id" value="${booking.id}"><button class="btn btn-outline-danger w-100">Cancel booking</button></form><p class="small text-secondary mt-2">Cancellation is allowed before the pickup date.</p></c:if><c:if test="${booking.status eq 'ACTIVE' or booking.status eq 'COMPLETED'}"><a class="btn btn-primary w-100" href="${pageContext.request.contextPath}/customer/invoices/details?id=${booking.id}"><i class="bi bi-printer me-1"></i>Open invoice</a></c:if><a class="btn btn-outline-secondary w-100 mt-2" href="${pageContext.request.contextPath}/customer/bookings">Back to bookings</a></div></div></div><%@ include file="../common/footer.jsp" %>
