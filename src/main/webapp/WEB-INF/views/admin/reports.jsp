<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Reports | Roadwise"/><%@ include file="../common/header.jsp" %><div class="page-heading"><span class="eyebrow">FLEET INSIGHTS</span><h1><c:out value="${reportTitle}"/></h1><p>Aggregated from bookings, rentals, and payment records.</p></div><div class="d-flex gap-2 mb-3"><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/admin/reports/revenue">Monthly revenue</a><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/admin/reports/utilization">Most rented cars</a></div><div class="content-card table-responsive"><table class="table data-table"><thead><tr><c:choose><c:when test="${reportMode eq 'revenue'}"><th>Month</th><th>Recorded revenue</th><th>Paid records</th></c:when><c:otherwise><th>Vehicle</th><th>Registration</th><th>Completed rentals</th><th>Rental days</th></c:otherwise></c:choose></tr></thead><tbody><c:forEach items="${reports}" var="row"><tr><c:choose><c:when test="${reportMode eq 'revenue'}"><td><c:out value="${row.month}"/></td><td>$<c:out value="${row.revenue}"/></td><td><c:out value="${row.payments}"/></td></c:when><c:otherwise><td><c:out value="${row.brand}"/> <c:out value="${row.model}"/></td><td><c:out value="${row.registrationNumber}"/></td><td><c:out value="${row.rentals}"/></td><td><c:out value="${row.rentalDays}"/></td></c:otherwise></c:choose></tr></c:forEach><c:if test="${empty reports}"><tr><td colspan="4" class="text-center text-secondary py-4">No report data available.</td></tr></c:if></tbody></table></div><%@ include file="../common/footer.jsp" %>
