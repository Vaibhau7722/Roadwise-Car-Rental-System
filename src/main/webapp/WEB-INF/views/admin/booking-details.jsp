<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Booking details | Roadwise"/><%@ include file="../common/header.jsp" %><div class="page-heading"><span class="eyebrow">RESERVATION</span><h1><c:out value="${booking.reference}"/></h1><span class="status status-${booking.status}"><c:out value="${booking.status}"/></span></div><div class="content-card"><div class="row g-4"><div class="col-md-6"><h2 class="h5">Customer</h2><div><c:out value="${booking.customerName}"/></div><div><c:out value="${booking.email}"/></div><div><c:out value="${booking.phone}"/></div></div><div class="col-md-6"><h2 class="h5">Vehicle</h2><div><c:out value="${booking.brand}"/> <c:out value="${booking.model}"/></div><div><c:out value="${booking.registrationNumber}"/></div></div><div class="col-md-6"><small>Pickup and return</small><div><c:out value="${booking.pickupDate}"/> to <c:out value="${booking.returnDate}"/> (<c:out value="${booking.rentalDays}"/> days)</div></div><div class="col-md-6"><small>Agreed daily rate / base price</small><div>$<c:out value="${booking.dailyRate}"/> / $<c:out value="${booking.baseAmount}"/></div></div><div class="col-md-6"><small>Actual pickup</small><div><c:out value="${booking.pickupAt}" default="Not recorded"/></div></div><div class="col-md-6"><small>Actual return</small><div><c:out value="${booking.actualReturnAt}" default="Not recorded"/></div></div></div><hr><div class="d-flex justify-content-between"><span>Late fees / current total</span><strong>$<c:out value="${booking.lateFee}"/> / $<c:out value="${booking.finalCharge}"/></strong></div><a class="btn btn-outline-secondary mt-3" href="${pageContext.request.contextPath}/admin/bookings">Back to bookings</a></div><%@ include file="../common/footer.jsp" %>
