<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Manage rentals | Roadwise"/><%@ include file="../common/header.jsp" %><div class="page-heading"><span class="eyebrow">VEHICLE HANDOVER</span><h1>Manage rentals</h1><p>Record pickups and returns. Late returns incur $25.00 per calendar day.</p></div><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>Reference / customer</th><th>Vehicle</th><th>Booked dates</th><th>Status</th><th>Actual return / charge</th><th>Action</th></tr></thead><tbody><c:forEach items="${bookings}" var="b"><c:if test="${b.status eq 'CONFIRMED' or b.status eq 'ACTIVE' or b.status eq 'COMPLETED'}"><tr><td><strong><c:out value="${b.reference}"/></strong><div class="small text-secondary"><c:out value="${b.customerName}"/></div></td><td><c:out value="${b.brand}"/> <c:out value="${b.model}"/></td><td><c:out value="${b.pickupDate}"/> – <c:out value="${b.returnDate}"/></td><td><span class="status status-${b.status}"><c:out value="${b.status}"/></span></td><td><c:out value="${b.actualReturnAt}" default="—"/><c:if test="${b.status eq 'COMPLETED'}"><div class="small">$<c:out value="${b.finalCharge}"/> · late: $<c:out value="${b.lateFee}"/></div></c:if></td><td><c:choose><c:when test="${b.status eq 'CONFIRMED'}"><form method="post" action="${pageContext.request.contextPath}/admin/rentals/pickup"><input type="hidden" name="_csrf" value="<c:out value='${requestScope.csrfToken}'/>"><input type="hidden" name="id" value="${b.id}"><button class="btn btn-sm btn-primary">Record pickup</button></form></c:when><c:when test="${b.status eq 'ACTIVE'}"><form method="post" action="${pageContext.request.contextPath}/admin/rentals/return"><input type="hidden" name="_csrf" value="<c:out value='${requestScope.csrfToken}'/>"><input type="hidden" name="id" value="${b.id}"><button class="btn btn-sm btn-primary">Record return</button></form></c:when><c:otherwise><span class="text-secondary small">Completed</span></c:otherwise></c:choose></td></tr></c:if></c:forEach></tbody></table></div><%@ include file="../common/footer.jsp" %>
