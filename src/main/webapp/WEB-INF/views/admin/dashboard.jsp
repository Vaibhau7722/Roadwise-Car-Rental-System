<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Admin dashboard | Roadwise"/><%@ include file="../common/header.jsp" %><div class="page-heading"><span class="eyebrow">ADMINISTRATION</span><h1>Dashboard</h1><p>Fleet and rental activity from the live database.</p></div><div class="row g-3 mb-4"><div class="col-6 col-lg-4"><div class="stat-card"><span>Total cars</span><strong><c:out value="${summary.totalCars}"/></strong><i class="bi bi-car-front"></i></div></div><div class="col-6 col-lg-4"><div class="stat-card"><span>Available cars</span><strong><c:out value="${summary.availableCars}"/></strong><i class="bi bi-check-circle"></i></div></div><div class="col-6 col-lg-4"><div class="stat-card"><span>Total customers</span><strong><c:out value="${summary.totalCustomers}"/></strong><i class="bi bi-people"></i></div></div><div class="col-6 col-lg-4"><div class="stat-card"><span>Total bookings</span><strong><c:out value="${summary.totalBookings}"/></strong><i class="bi bi-journal-check"></i></div></div><div class="col-6 col-lg-4"><div class="stat-card"><span>Active rentals</span><strong><c:out value="${summary.activeRentals}"/></strong><i class="bi bi-key"></i></div></div><div class="col-6 col-lg-4"><div class="stat-card"><span>Recorded revenue</span><strong>$<c:out value="${summary.totalRevenue}"/></strong><i class="bi bi-cash-stack"></i></div></div></div><div class="d-flex flex-wrap gap-2 mb-4"><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/cars/create">Add a car</a><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/admin/bookings">Manage bookings</a><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/admin/reports/revenue">Reports</a></div><div class="content-card"><div class="d-flex justify-content-between"><h2 class="h5">Latest bookings</h2><a href="${pageContext.request.contextPath}/admin/bookings">View all</a></div><div class="table-responsive"><table class="table data-table"><thead><tr><th>Reference</th><th>Customer</th><th>Car</th><th>Dates</th><th>Status</th><th></th></tr></thead><tbody><c:forEach items="${bookings}" var="b"><tr><td><c:out value="${b.reference}"/></td><td><c:out value="${b.customerName}"/></td><td><c:out value="${b.brand}"/> <c:out value="${b.model}"/></td><td><c:out value="${b.pickupDate}"/> – <c:out value="${b.returnDate}"/></td><td><span class="status status-${b.status}"><c:out value="${b.status}"/></span></td><td><a href="${pageContext.request.contextPath}/admin/bookings/details?id=${b.id}">Details</a></td></tr></c:forEach></tbody></table></div></div><%@ include file="../common/footer.jsp" %>
